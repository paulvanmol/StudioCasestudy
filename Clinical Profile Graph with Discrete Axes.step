mnselector\",\n\t\t\t\t\t\t\t\"label\": \"Median variable:\",\n\t\t\t\t\t\t\t\"table\": \"inputtable1\",\n\t\t\t\t\t\t\t\"columntype\": \"n\",\n\t\t\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"lclvar\",\n\t\t\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\t\t\"label\": \"LCL variable:\",\n\t\t\t\t\t\t\t\"table\": \"inputtable1\",\n\t\t\t\t\t\t\t\"columntype\": \"n\",\n\t\t\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"uclvar\",\n\t\t\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\t\t\"label\": \"UCL variable:\",\n\t\t\t\t\t\t\t\"table\": \"inputtable1\",\n\t\t\t\t\t\t\t\"columntype\": \"n\",\n\t\t\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"appearancePage\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Appearance\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"graphOptionsSection\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Graph Options\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"title1\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Title:\",\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"Enter a title\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"theme\",\n\t\t\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\t\t\"label\": \"Color theme:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"inspire\",\n\t\t\t\t\t\t\t\t\t\"label\": \"SAS Inspire\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"illuminate\",\n\t\t\t\t\t\t\t\t\t\"label\": \"SAS Illuminate\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"grayscale\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Grayscale\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"pastel\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Pastel\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"bright\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Bright\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"dark\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Dark\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"default\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Default (no colors specified)\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"legendloc\",\n\t\t\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\t\t\"label\": \"Legend location:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"inside\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Inside\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"outside\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Outside\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"legendpos\",\n\t\t\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\t\t\"label\": \"Legend position:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"bottom\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Bottom\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"bottomleft\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Bottom Left\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"bottomright\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Bottom Right\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"left\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Left\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"right\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Right\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"top\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Top\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"topleft\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Top Left\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"topright\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Top Right\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"orientation\",\n\t\t\t\t\t\t\t\"type\": \"radiogroup\",\n\t\t\t\t\t\t\t\"label\": \"Legend orientation:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"automatic\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Automatic\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"horizontal\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Horizontal\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"vertical\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Vertical\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"about\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"aboutText\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"The **Clinical Profile Graph with Discrete Axes** custom step creates a plot of median (or mean) values by visit/day and treatment group, with confidence limits and a discrete X axis. It is a SAS Studio Custom Step conversion of the \\\"Lipid Profile\\\" Custom Task (Custom Task Tuesday, May 2019), based on Sanjay Matange's Graphically Speaking post on graphs with axis-aligned statistics tables.\\n\\nUSER INTERFACE\\n\\n- Input table: the summary data set (one row per visit x treatment).\\n- Treatment variable: character grouping variable.\\n- Day/visit variable: character variable plotted on the discrete X axis.\\n- Median variable: numeric Y value (series/scatter marker).\\n- LCL / UCL variable: numeric lower/upper confidence limit for the error bars.\\n- Title, color theme, legend location/position/orientation: standard styling options.\\n\\nConverted from Custom Task XML (Velocity) to a Custom Step (JSON UI + SAS macro language).\\nVersion 1.0.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"title1\": {\n\t\t\t\"value\": \"Median of Lipid Profile by Visit and Treatment\"\n\t\t},\n\t\t\"theme\": {\n\t\t\t\"value\": \"inspire\"\n\t\t},\n\t\t\"legendloc\": {\n\t\t\t\"value\": \"inside\"\n\t\t},\n\t\t\"legendpos\": {\n\t\t\t\"value\": \"topright\"\n\t\t},\n\t\t\"orientation\": {\n\t\t\t\"value\": \"vertical\"\n\t\t}\n\t}\n}","localUi":"{\"pages\":[{\"children\":[{\"id\":\"inputtable1\",\"label\":\"Input table\",\"placeholder\":\"\",\"required\":true,\"type\":\"inputtable\"},{\"children\":[{\"columntype\":\"c\",\"id\":\"groupvar\",\"label\":\"Treatment variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"c\",\"id\":\"dayvar\",\"label\":\"Day/visit variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"n\",\"id\":\"medianvar\",\"label\":\"Median variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"n\",\"id\":\"lclvar\",\"label\":\"LCL variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"n\",\"id\":\"uclvar\",\"label\":\"UCL variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"}],\"id\":\"rolesSection\",\"label\":\"Roles\",\"open\":true,\"type\":\"section\"}],\"id\":\"dataPage\",\"label\":\"Data\",\"type\":\"page\"},{\"children\":[{\"children\":[{\"id\":\"title1\",\"label\":\"Title:\",\"placeholder\":\"Enter a title\",\"required\":true,\"type\":\"textfield\",\"visible\":\"\"},{\"id\":\"theme\",\"items\":[{\"label\":\"SAS Inspire\",\"value\":\"inspire\"},{\"label\":\"SAS Illuminate\",\"value\":\"illuminate\"},{\"label\":\"Grayscale\",\"value\":\"grayscale\"},{\"label\":\"Pastel\",\"value\":\"pastel\"},{\"label\":\"Bright\",\"value\":\"bright\"},{\"label\":\"Dark\",\"value\":\"dark\"},{\"label\":\"Default (no colors specified)\",\"value\":\"default\"}],\"label\":\"Color theme:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\"},{\"id\":\"legendloc\",\"items\":[{\"label\":\"Inside\",\"value\":\"inside\"},{\"label\":\"Outside\",\"value\":\"outside\"}],\"label\":\"Legend location:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\"},{\"id\":\"legendpos\",\"items\":[{\"label\":\"Bottom\",\"value\":\"bottom\"},{\"label\":\"Bottom Left\",\"value\":\"bottomleft\"},{\"label\":\"Bottom Right\",\"value\":\"bottomright\"},{\"label\":\"Left\",\"value\":\"left\"},{\"label\":\"Right\",\"value\":\"right\"},{\"label\":\"Top\",\"value\":\"top\"},{\"label\":\"Top Left\",\"value\":\"topleft\"},{\"label\":\"Top Right\",\"value\":\"topright\"}],\"label\":\"Legend position:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\"},{\"id\":\"orientation\",\"items\":[{\"label\":\"Automatic\",\"value\":\"automatic\"},{\"label\":\"Horizontal\",\"value\":\"horizontal\"},{\"label\":\"Vertical\",\"value\":\"vertical\"}],\"label\":\"Legend orientation:\",\"type\":\"radiogroup\",\"visible\":\"\"}],\"id\":\"graphOptionsSection\",\"label\":\"Graph Options\",\"open\":true,\"type\":\"section\"}],\"id\":\"appearancePage\",\"label\":\"Appearance\",\"type\":\"page\"},{\"children\":[{\"id\":\"aboutText\",\"text\":\"The **Clinical Profile Graph with Discrete Axes** custom step creates a plot of median (or mean) values by visit/day and treatment group, with confidence limits and a discrete X axis. It is a SAS Studio Custom Step conversion of the \\\"Lipid Profile\\\" Custom Task (Custom Task Tuesday, May 2019), based on Sanjay Matange's Graphically Speaking post on graphs with axis-aligned statistics tables.\\n\\nUSER INTERFACE\\n\\n- Input table: the summary data set (one row per visit x treatment).\\n- Treatment variable: character grouping variable.\\n- Day/visit variable: character variable plotted on the discrete X axis.\\n- Median variable: numeric Y value (series/scatter marker).\\n- LCL / UCL variable: numeric lower/upper confidence limit for the error bars.\\n- Title, color theme, legend location/position/orientation: standard styling options.\\n\\nConverted from Custom Task XML (Velocity) to a Custom Step (JSON UI + SAS macro language).\\nVersion 1.0.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"about\",\"label\":\"About\",\"type\":\"page\"}],\"showPageContentOnly\":true,\"syntaxversion\":\"1.3.0\",\"values\":{\"legendloc\":{\"value\":\"inside\"},\"legendpos\":{\"value\":\"topright\"},\"orientation\":{\"value\":\"vertical\"},\"theme\":{\"value\":\"inspire\"},\"title1\":{\"value\":\"Median of Lipid Profile by Visit and Treatment\"}}}","templates":{"SAS":"/*============================================================================*\n * Custom Step:   Clinical Profile Graph with Discrete Axes                   *\n * Converted from the SAS Studio Custom Task \"Lipid Profile\"                  *\n * (Velocity XML .ctm) shown in Custom Task Tuesday, May 2019.                *\n *============================================================================*/\n\n%macro _clin_profile(\n        data=,\n        groupvar=,      /* character treatment variable                    */\n        dayvar=,        /* character visit/day variable - discrete X axis  */\n        medianvar=,     /* numeric median (or mean) variable               */\n        lclvar=,        /* numeric lower confidence limit variable         */\n        uclvar=,        /* numeric upper confidence limit variable         */\n        title1=,\n        theme=,\n        legendloc=,\n        legendpos=,\n        orientation=\n        );\n\n    %local linecolors;\n\n    %if %upcase(&theme)=INSPIRE %then\n        %let linecolors=cx1d9992 cx2222bc cx6a9617 cx69256d cxba7006 cx0a9e69 cxa50a2f;\n    %else %if %upcase(&theme)=ILLUMINATE %then\n        %let linecolors=cx007380 cxd16100 cx719409 cx1e3b8f cxe0ab1a cx87235d cx7d0a00 cx544600;\n    %else %if %upcase(&theme)=GRAYSCALE %then\n        %let linecolors=cx585858 cxa2a2a2 cx1e1e1e cx707070 cxbbbbbb cx3b3b3b cxd0d0d0;\n    %else %if %upcase(&theme)=PASTEL %then\n        %let linecolors=cx80AF9A cxCA9A79 cx98A2B5 cxC197B1 cxB3C296 cxCCBF7B cxBEAF99 cx999999;\n    %else %if %upcase(&theme)=BRIGHT %then\n        %let linecolors=cx1776b6 cxff7f00 cx24a121 cxd8241f cx9564bf cx8d5649 cxe574c3 cxbcbf00;\n    %else %if %upcase(&theme)=DARK %then\n        %let linecolors=cx1b9e77 cxd95f02 cx7570b3 cxe7298a cx66a61e cxe6ab02 cxa6761d cx666666;\n\n    title \"&title1\";\n\n    proc sgplot data=&data;\n        %if %upcase(&theme) ne DEFAULT %then %do;\n            styleattrs datacontrastcolors=(&linecolors);\n        %end;\n\n        series x=&dayvar y=&medianvar / group=&groupvar\n            groupdisplay=cluster clusterwidth=0.5\n            lineattrs=(thickness=2) name='s';\n\n        scatter x=&dayvar y=&medianvar /\n            yerrorlower=&lclvar yerrorupper=&uclvar\n            group=&groupvar groupdisplay=cluster clusterwidth=0.5\n            markerattrs=(symbol=circlefilled size=11)\n            errorbarattrs=(thickness=2);\n\n        yaxis label='Median with 95% CL' grid;\n        xaxis display=(nolabel);\n\n        keylegend 's' / title='Treatment' location=&legendloc position=&legendpos\n            %if %upcase(&orientation)=HORIZONTAL %then %do; down=1 %end;\n            %if %upcase(&orientation)=VERTICAL %then %do; across=1 %end;\n            ;\n    run;\n\n    title;\n%mend _clin_profile;\n\n%_clin_profile(\n    data=&inputtable1,\n    groupvar=&groupvar,\n    dayvar=&dayvar,\n    medianvar=&medianvar,\n    lclvar=&lclvar,\n    uclvar=&uclvar,\n    title1=&title1,\n    theme=&theme,\n    legendloc=&legendloc,\n    legendpos=&legendpos,\n    orientation=&orientation\n    );\n"}}
