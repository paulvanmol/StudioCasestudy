{"creationTimeStamp":"2026-07-31T09:17:09.834055Z","createdBy":"sbxpav","modifiedTimeStamp":"2026-07-31T09:17:09.834055Z","modifiedBy":"sbxpav","id":"5788a73c-c806-4940-8654-0bba94387a0f","name":"Clinical Profile Graph with Discrete Axes.step","displayName":"Clinical Profile Graph with Discrete Axes","localDisplayName":"Clinical Profile Graph with Discrete Axes","description":"Creates a median/mean profile plot with confidence limits by visit and treatment group on a discrete X axis. Converted from the Custom Task 'Lipid Profile'.","localDescription":"Creates a median/mean profile plot with confidence limits by visit and treatment group on a discrete X axis. Converted from the Custom Task 'Lipid Profile'.","links":[{"method":"GET","rel":"self","href":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f","uri":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f","type":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"alternate","href":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f","uri":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f","type":"application/vnd.sas.data.flow.step.summary"},{"method":"GET","rel":"up","href":"/dataFlows/steps","uri":"/dataFlows/steps","type":"application/vnd.sas.collection","itemType":"application/vnd.sas.data.flow.step.summary"},{"method":"PUT","rel":"update","href":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f","uri":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f","type":"application/vnd.sas.data.flow.step","responseType":"application/vnd.sas.data.flow.step"},{"method":"DELETE","rel":"delete","href":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f","uri":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f"},{"method":"POST","rel":"copy","href":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f/copy","uri":"/dataFlows/steps/5788a73c-c806-4940-8654-0bba94387a0f/copy","responseType":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"transferExport","href":"/dataFlows/