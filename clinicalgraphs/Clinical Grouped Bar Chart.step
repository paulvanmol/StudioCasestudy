{"creationTimeStamp":"2026-07-31T09:17:10.806935Z","createdBy":"sbxpav","modifiedTimeStamp":"2026-07-31T09:17:10.806935Z","modifiedBy":"sbxpav","id":"9646d2d9-92cb-44af-a8bd-b6be19a37209","name":"Clinical Grouped Bar Chart.step","displayName":"Clinical Grouped Bar Chart","localDisplayName":"Clinical Grouped Bar Chart","description":"Creates a clustered/grouped bar chart showing incidence of a response by time and cohort. Converted from the Custom Task 'Injection Site Reaction'.","localDescription":"Creates a clustered/grouped bar chart showing incidence of a response by time and cohort. Converted from the Custom Task 'Injection Site Reaction'.","links":[{"method":"GET","rel":"self","href":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","uri":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","type":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"alternate","href":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","uri":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","type":"application/vnd.sas.data.flow.step.summary"},{"method":"GET","rel":"up","href":"/dataFlows/steps","uri":"/dataFlows/steps","type":"application/vnd.sas.collection","itemType":"application/vnd.sas.data.flow.step.summary"},{"method":"PUT","rel":"update","href":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","uri":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","type":"application/vnd.sas.data.flow.step","responseType":"application/vnd.sas.data.flow.step"},{"method":"DELETE","rel":"delete","href":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","uri":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209"},{"method":"POST","rel":"copy","href":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209/copy","uri":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209/copy","responseType":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"transferExport","href":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","uri":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","responseType":"application/vnd.sas.transfer.object"},{"method":"PUT","rel":"transferImportUpdate","href":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","uri":"/dataFlows/steps/9646d2d9-92cb-44af-a8bd-b6be19a37209","type":"application/vnd.sas.transfer.object","responseType":"application/vnd.sas.summary"}],"metadataVersion":0,"version":2,"type":"code","flowMetadata":{"inputPorts":[{"name":"inputtable1","displayName":"inputtable1","localDisplayName":"inputtable1","minEntries":1,"maxEntries":1,"defaultEntries":0,"type":"table"}]},"ui":"{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"dataPage\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Data\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"inputtable1\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Input table\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"rolesSection\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Roles\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"timevar\",\n\t\t\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\t\t\"label\": \"Time variable:\",\n\t\t\t\t\t\t\t\"table\": \"inputtable1\",\n\t\t\t\t\t\t\t\"columntype\": \"c\",\n\t\t\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"respvar\",\n\t\t\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\t\t\"label\": \"Response variable:\",\n\t\t\t\t\t\t\t\"table\": \"inputtable1\",\n\t\t\t\t\t\t\t\"columntype\": \"n\",\n\t\t\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"groupvar\",\n\t\t\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\t\t\"label\": \"Group variable:\",\n\t\t\t\t\t\t\t\"table\": \"inputtable1\",\n\t\t\t\t\t\t\t\"columntype\": \"c\",\n\t\t\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"appearancePage\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Appearance\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"graphOptionsSection\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Graph Options\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"title1\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Title 1:\",\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"Enter a title\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"title2\",\n\t\t\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\t\t\"label\": \"Title 2:\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"placeholder\": \"Enter a second title\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"theme\",\n\t\t\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\t\t\"label\": \"Color theme:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"inspire\",\n\t\t\t\t\t\t\t\t\t\"label\": \"SAS Inspire\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"illuminate\",\n\t\t\t\t\t\t\t\t\t\"label\": \"SAS Illuminate\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"grayscale\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Grayscale\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"pastel\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Pastel\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"bright\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Bright\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"dark\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Dark\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"default\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Default (no colors specified)\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"legendloc\",\n\t\t\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\t\t\"label\": \"Legend location:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"inside\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Inside\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"outside\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Outside\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"legendpos\",\n\t\t\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\t\t\"label\": \"Legend position:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"bottom\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Bottom\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"bottomleft\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Bottom Left\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"bottomright\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Bottom Right\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"left\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Left\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"right\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Right\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"top\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Top\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"topleft\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Top Left\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"topright\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Top Right\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"orientation\",\n\t\t\t\t\t\t\t\"type\": \"radiogroup\",\n\t\t\t\t\t\t\t\"label\": \"Legend orientation:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"automatic\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Automatic\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"horizontal\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Horizontal\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"vertical\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Vertical\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"about\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"aboutText\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"The **Clinical Grouped Bar Chart** custom step creates a clustered/grouped bar chart showing incidence of a response by time and cohort. It is a SAS Studio Custom Step conversion of the \\\"Injection Site Reaction\\\" Custom Task (Custom Task Tuesday, May 2019), based on Sanjay Matange's Graphically Speaking post on clinical graphs.\\n\\nUSER INTERFACE\\n\\n- Input table: the summary data set (one row per time x group).\\n- Time variable: character variable plotted on the discrete X axis.\\n- Response variable: numeric incidence/response value plotted as the bar response.\\n- Group variable: character cohort variable used to cluster/group the bars.\\n- Title 1 / Title 2, color theme, legend location/position/orientation: standard styling options.\\n\\nConverted from Custom Task XML (Velocity) to a Custom Step (JSON UI + SAS macro language).\\nVersion 1.0.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"title1\": {\n\t\t\t\"value\": \"Incidence of Injection-site Reaction by Time and Cohort - Erythema\"\n\t\t},\n\t\t\"title2\": {\n\t\t\t\"value\": \"ATT Population\"\n\t\t},\n\t\t\"theme\": {\n\t\t\t\"value\": \"inspire\"\n\t\t},\n\t\t\"legendloc\": {\n\t\t\t\"value\": \"inside\"\n\t\t},\n\t\t\"legendpos\": {\n\t\t\t\"value\": \"topright\"\n\t\t},\n\t\t\"orientation\": {\n\t\t\t\"value\": \"automatic\"\n\t\t}\n\t}\n}","localUi":"{\"pages\":[{\"children\":[{\"id\":\"inputtable1\",\"label\":\"Input table\",\"placeholder\":\"\",\"required\":true,\"type\":\"inputtable\"},{\"children\":[{\"columntype\":\"c\",\"id\":\"timevar\",\"label\":\"Time variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"n\",\"id\":\"respvar\",\"label\":\"Response variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"c\",\"id\":\"groupvar\",\"label\":\"Group variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"}],\"id\":\"rolesSection\",\"label\":\"Roles\",\"open\":true,\"type\":\"section\"}],\"id\":\"dataPage\",\"label\":\"Data\",\"type\":\"page\"},{\"children\":[{\"children\":[{\"id\":\"title1\",\"label\":\"Title 1:\",\"placeholder\":\"Enter a title\",\"required\":true,\"type\":\"textfield\",\"visible\":\"\"},{\"id\":\"title2\",\"label\":\"Title 2:\",\"placeholder\":\"Enter a second title\",\"required\":false,\"type\":\"textfield\",\"visible\":\"\"},{\"id\":\"theme\",\"items\":[{\"label\":\"SAS Inspire\",\"value\":\"inspire\"},{\"label\":\"SAS Illuminate\",\"value\":\"illuminate\"},{\"label\":\"Grayscale\",\"value\":\"grayscale\"},{\"label\":\"Pastel\",\"value\":\"pastel\"},{\"label\":\"Bright\",\"value\":\"bright\"},{\"label\":\"Dark\",\"value\":\"dark\"},{\"label\":\"Default (no colors specified)\",\"value\":\"default\"}],\"label\":\"Color theme:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\"},{\"id\":\"legendloc\",\"items\":[{\"label\":\"Inside\",\"value\":\"inside\"},{\"label\":\"Outside\",\"value\":\"outside\"}],\"label\":\"Legend location:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\"},{\"id\":\"legendpos\",\"items\":[{\"label\":\"Bottom\",\"value\":\"bottom\"},{\"label\":\"Bottom Left\",\"value\":\"bottomleft\"},{\"label\":\"Bottom Right\",\"value\":\"bottomright\"},{\"label\":\"Left\",\"value\":\"left\"},{\"label\":\"Right\",\"value\":\"right\"},{\"label\":\"Top\",\"value\":\"top\"},{\"label\":\"Top Left\",\"value\":\"topleft\"},{\"label\":\"Top Right\",\"value\":\"topright\"}],\"label\":\"Legend position:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\"},{\"id\":\"orientation\",\"items\":[{\"label\":\"Automatic\",\"value\":\"automatic\"},{\"label\":\"Horizontal\",\"value\":\"horizontal\"},{\"label\":\"Vertical\",\"value\":\"vertical\"}],\"label\":\"Legend orientation:\",\"type\":\"radiogroup\",\"visible\":\"\"}],\"id\":\"graphOptionsSection\",\"label\":\"Graph Options\",\"open\":true,\"type\":\"section\"}],\"id\":\"appearancePage\",\"label\":\"Appearance\",\"type\":\"page\"},{\"children\":[{\"id\":\"aboutText\",\"text\":\"The **Clinical Grouped Bar Chart** custom step creates a clustered/grouped bar chart showing incidence of a response by time and cohort. It is a SAS Studio Custom Step conversion of the \\\"Injection Site Reaction\\\" Custom Task (Custom Task Tuesday, May 2019), based on Sanjay Matange's Graphically Speaking post on clinical graphs.\\n\\nUSER INTERFACE\\n\\n- Input table: the summary data set (one row per time x group).\\n- Time variable: character variable plotted on the discrete X axis.\\n- Response variable: numeric incidence/response value plotted as the bar response.\\n- Group variable: character cohort variable used to cluster/group the bars.\\n- Title 1 / Title 2, color theme, legend location/position/orientation: standard styling options.\\n\\nConverted from Custom Task XML (Velocity) to a Custom Step (JSON UI + SAS macro language).\\nVersion 1.0.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"about\",\"label\":\"About\",\"type\":\"page\"}],\"showPageContentOnly\":true,\"syntaxversion\":\"1.3.0\",\"values\":{\"legendloc\":{\"value\":\"inside\"},\"legendpos\":{\"value\":\"topright\"},\"orientation\":{\"value\":\"automatic\"},\"theme\":{\"value\":\"inspire\"},\"title1\":{\"value\":\"Incidence of Injection-site Reaction by Time and Cohort - Erythema\"},\"title2\":{\"value\":\"ATT Population\"}}}","templates":{"SAS":"/*============================================================================*\n * Custom Step:   Clinical Grouped Bar Chart                                  *\n * Converted from the SAS Studio Custom Task \"Injection Site Reaction\"        *\n * (Velocity XML .ctm) shown in Custom Task Tuesday, May 2019.                *\n *============================================================================*/\n\n%macro _clin_groupedbar(\n        data=,\n        timevar=,       /* character time/visit variable - X axis          */\n        respvar=,       /* numeric response/incidence variable             */\n        groupvar=,      /* character group/cohort variable                 */\n        title1=,\n        title2=,\n        theme=,\n        legendloc=,\n        legendpos=,\n        orientation=\n        );\n\n    %local fillcolors;\n\n    %if %upcase(&theme)=INSPIRE %then\n        %let fillcolors=cx21b9b7 cx4141e0 cx7db71a cx8e2f8a cxd38506 cx0abf85 cx2f90ec;\n    %else %if %upcase(&theme)=ILLUMINATE %then\n        %let fillcolors=cx00929f cxf08000 cx90b328 cx3d5aae cxffca39 cxa6427c cx9c2910 cx736519;\n    %else %if %upcase(&theme)=GRAYSCALE %then\n        %let fillcolors=cx585858 cxa2a2a2 cx1e1e1e cx707070 cxbbbbbb cx3b3b3b cxd0d0d0;\n    %else %if %upcase(&theme)=PASTEL %then\n        %let fillcolors=cxb3e2cd cxfdcdac cxcbd5e8 cxf4cae4 cxe6f5c9 cxfff2ae cxf1e2cc cxcccccc;\n    %else %if %upcase(&theme)=BRIGHT %then\n        %let fillcolors=cx3190D0 cxFF991A cx3EBB3B cxF23E39 cxAF7ED9 cxA77063 cxFF8EDD cxD6D91A;\n    %else %if %upcase(&theme)=DARK %then\n        %let fillcolors=cx1b9e77 cxd95f02 cx7570b3 cxe7298a cx66a61e cxe6ab02 cxa6761d cx666666;\n\n    title \"&title1\";\n    %if %length(&title2) %then %do;\n        title2 \"&title2\";\n    %end;\n\n    proc sgplot data=&data nowall noborder;\n        %if %upcase(&theme) ne DEFAULT %then %do;\n            styleattrs datacolors=(&fillcolors) datacontrastcolors=(black);\n        %end;\n\n        vbar &timevar /\n            response=&respvar\n            group=&groupvar\n            groupdisplay=cluster\n            baselineattrs=(thickness=0);\n\n        xaxis discreteorder=data;\n        yaxis offsetmax=0.2;\n\n        keylegend / title='' location=&legendloc position=&legendpos border\n            autoitemsize valueattrs=(size=8)\n            %if %upcase(&orientation)=HORIZONTAL %then %do; down=1 %end;\n            %if %upcase(&orientation)=VERTICAL %then %do; across=1 %end;\n            ;\n    run;\n\n    title;\n%mend _clin_groupedbar;\n\n%_clin_groupedbar(\n    data=&inputtable1,\n    timevar=&timevar,\n    respvar=&respvar,\n    groupvar=&groupvar,\n    title1=&title1,\n    title2=&title2,\n    theme=&theme,\n    legendloc=&legendloc,\n    legendpos=&legendpos,\n    orientation=&orientation\n    );\n"}}
