{
  "type": "code",
  "name": "Clinical Forest Plot",
  "displayName": "Clinical Forest Plot",
  "description": "Subgroup forest plot of hazard ratios with 95% CI, N column and HR (CI) text column on a log scale. Expects one row per subgroup category with estimate and confidence limits.",
  "templates": {
    "SAS": "/* Clinical Forest Plot */\ndata work._forest;\n  length _label $80 _ci $30;\n  set &inputtable1;\n  by &grpVar_1_name notsorted;\n  _ord + 1;\n  _ci = cats(put(&estVar_1_name,5.2),' (',put(&lclVar_1_name,5.2),', ',put(&uclVar_1_name,5.2),')');\n  if first.&grpVar_1_name and &grpVar_1_name ne &catVar_1_name then do;\n    _label=&grpVar_1_name; _ind=0; _bold=1;\n    _est=.; _lcl=.; _ucl=.; _n=.; _cil=' '; output; _ord+1;\n  end;\n  _label=&catVar_1_name; _ind=1; _bold=0;\n  _est=&estVar_1_name; _lcl=&lclVar_1_name; _ucl=&uclVar_1_name; _n=&nVar_1_name; _cil=_ci; output;\n  label _n='N' _cil='HR (95% CI)';\nrun;\nods graphics on / width=9in height=%sysevalf(1.5+0.3*&sysnobs)in;\ntitle \"&title\";\nproc sgplot data=work._forest noautolegend nowall noborder;\n  refline &refVal / axis=x lineattrs=(pattern=shortdash);\n  highlow y=_ord low=_lcl high=_ucl;\n  scatter y=_ord x=_est / markerattrs=(symbol=squarefilled);\n  yaxistable _label / location=inside position=left indentweight=_ind textgroup=_bold nolabel;\n  yaxistable _n _cil / location=inside position=right;\n  yaxis reverse display=none;\n  xaxis type=log label=\"&xLabel\";\nrun;\ntitle;\n"
  },
  "prompts": {},
  "ui": "{\"showPageContentOnly\": true, \"pages\": [{\"id\": \"page1\", \"type\": \"page\", \"label\": \"Options\", \"children\": [{\"id\": \"inputtable1\", \"type\": \"inputtable\", \"label\": \"Input table\", \"required\": true, \"placeholder\": \"\", \"visible\": \"\"}, {\"id\": \"grpVar\", \"type\": \"columnselector\", \"label\": \"Subgroup variable\", \"include\": null, \"order\": false, \"columntype\": \"a\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"catVar\", \"type\": \"columnselector\", \"label\": \"Category variable\", \"include\": null, \"order\": false, \"columntype\": \"a\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"nVar\", \"type\": \"columnselector\", \"label\": \"N variable\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"estVar\", \"type\": \"columnselector\", \"label\": \"Estimate (HR)\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"lclVar\", \"type\": \"columnselector\", \"label\": \"Lower CL\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"uclVar\", \"type\": \"columnselector\", \"label\": \"Upper CL\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"refVal\", \"type\": \"textfield\", \"label\": \"Reference line\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}, {\"id\": \"xLabel\", \"type\": \"textfield\", \"label\": \"X-axis label\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}, {\"id\": \"title\", \"type\": \"textfield\", \"label\": \"Graph title\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}]}, {\"id\": \"about\", \"type\": \"page\", \"label\": \"About\", \"children\": [{\"id\": \"abouttext\", \"type\": \"text\", \"text\": \"Subgroup forest plot of hazard ratios with 95% CI, N column and HR (CI) text column on a log scale. Expects one row per subgroup category with estimate and confidence limits.\", \"visible\": \"\"}]}], \"syntaxversion\": \"1.3.0\", \"values\": {\"inputtable1\": {\"library\": \"\", \"table\": \"\"}, \"grpVar\": [], \"catVar\": [], \"nVar\": [], \"estVar\": [], \"lclVar\": [], \"uclVar\": [], \"refVal\": \"1\", \"xLabel\": \"Hazard Ratio (95% CI)  <- favours treatment | favours control ->\", \"title\": \"\"}}",
  "flowMetadata": "{\"inputPorts\": [{\"name\": \"inputtable1\", \"displayName\": \"inputtable1\", \"minEntries\": 1, \"maxEntries\": 1, \"defaultBindingType\": \"table\"}], \"outputPorts\": []}"
}