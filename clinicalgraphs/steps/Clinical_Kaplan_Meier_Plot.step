{
  "type": "code",
  "name": "Clinical Kaplan-Meier Plot",
  "displayName": "Clinical Kaplan-Meier Plot",
  "description": "Kaplan-Meier survival curves by treatment with number-at-risk table, censoring marks and log-rank p-value (PROC LIFETEST). Expects ADTTE structure: one record per subject, AVAL time, CNSR=1 censored.",
  "templates": {
    "SAS": "/* Clinical Kaplan-Meier Plot */\nods graphics on / width=8in height=5in;\ntitle \"&title\";\nproc lifetest data=&inputtable1 plots=survival(atrisk(outside maxlen=13)=0 to 10000 by &byInt test) notable;\n  time &timeVar_1_name * &cnsrVar_1_name(1);\n  strata &trtVar_1_name / test=logrank;\nrun;\ntitle;\n"
  },
  "prompts": {},
  "ui": "{\"showPageContentOnly\": true, \"pages\": [{\"id\": \"page1\", \"type\": \"page\", \"label\": \"Options\", \"children\": [{\"id\": \"inputtable1\", \"type\": \"inputtable\", \"label\": \"Input table\", \"required\": true, \"placeholder\": \"\", \"visible\": \"\"}, {\"id\": \"timeVar\", \"type\": \"columnselector\", \"label\": \"Time variable (AVAL)\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"cnsrVar\", \"type\": \"columnselector\", \"label\": \"Censor variable (CNSR, 1=censored)\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"trtVar\", \"type\": \"columnselector\", \"label\": \"Treatment variable\", \"include\": null, \"order\": false, \"columntype\": \"a\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"byInt\", \"type\": \"textfield\", \"label\": \"Number-at-risk interval\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}, {\"id\": \"title\", \"type\": \"textfield\", \"label\": \"Graph title\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}]}, {\"id\": \"about\", \"type\": \"page\", \"label\": \"About\", \"children\": [{\"id\": \"abouttext\", \"type\": \"text\", \"text\": \"Kaplan-Meier survival curves by treatment with number-at-risk table, censoring marks and log-rank p-value (PROC LIFETEST). Expects ADTTE structure: one record per subject, AVAL time, CNSR=1 censored.\", \"visible\": \"\"}]}], \"syntaxversion\": \"1.3.0\", \"values\": {\"inputtable1\": {\"library\": \"\", \"table\": \"\"}, \"timeVar\": [], \"cnsrVar\": [], \"trtVar\": [], \"byInt\": \"90\", \"title\": \"\"}}",
  "flowMetadata": "{\"inputPorts\": [{\"name\": \"inputtable1\", \"displayName\": \"inputtable1\", \"minEntries\": 1, \"maxEntries\": 1, \"defaultBindingType\": \"table\"}], \"outputPorts\": []}"
}