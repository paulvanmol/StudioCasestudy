{
  "type": "code",
  "name": "Clinical Mean Over Time",
  "displayName": "Clinical Mean Over Time",
  "description": "Mean (+/- SE) profile over visits by treatment, e.g. change from baseline in a lab or efficacy parameter. Summary statistics are computed by the step.",
  "templates": {
    "SAS": "/* Clinical Mean Over Time */\nproc means data=&inputtable1 noprint nway;\n  class &trtVar_1_name &visVar_1_name;\n  var &valVar_1_name;\n  output out=work._mean n=n mean=mean stderr=se lclm=lclm uclm=uclm;\nrun;\ndata work._mean; set work._mean;\n  %if \"&stat\"=\"SE\" %then %do; low=mean-se; high=mean+se; %end;\n  %else %do; low=lclm; high=uclm; %end;\nrun;\nods graphics on / width=9in height=5in;\ntitle \"&title\";\nproc sgplot data=work._mean;\n  series x=&visVar_1_name y=mean / group=&trtVar_1_name groupdisplay=cluster clusterwidth=0.3 markers name='s';\n  highlow x=&visVar_1_name low=low high=high / group=&trtVar_1_name groupdisplay=cluster clusterwidth=0.3 lowcap=serif highcap=serif;\n  refline 0 / axis=y lineattrs=(pattern=dot);\n  xaxistable n / class=&trtVar_1_name colorgroup=&trtVar_1_name location=outside title='Number of subjects';\n  xaxis type=discrete label='Visit';\n  yaxis label=\"&yLabel (&stat)\";\n  keylegend 's' / title='';\nrun;\ntitle;\n"
  },
  "prompts": {},
  "ui": "{\"showPageContentOnly\": true, \"pages\": [{\"id\": \"page1\", \"type\": \"page\", \"label\": \"Options\", \"children\": [{\"id\": \"inputtable1\", \"type\": \"inputtable\", \"label\": \"Input table\", \"required\": true, \"placeholder\": \"\", \"visible\": \"\"}, {\"id\": \"visVar\", \"type\": \"columnselector\", \"label\": \"Visit number variable\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"valVar\", \"type\": \"columnselector\", \"label\": \"Analysis value (e.g. CHG)\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"trtVar\", \"type\": \"columnselector\", \"label\": \"Treatment variable\", \"include\": null, \"order\": false, \"columntype\": \"a\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"stat\", \"type\": \"dropdown\", \"label\": \"Error bar\", \"items\": [{\"value\": \"SE\"}, {\"value\": \"95% CI\"}], \"required\": true, \"visible\": \"\"}, {\"id\": \"yLabel\", \"type\": \"textfield\", \"label\": \"Y-axis label\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}, {\"id\": \"title\", \"type\": \"textfield\", \"label\": \"Graph title\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}]}, {\"id\": \"about\", \"type\": \"page\", \"label\": \"About\", \"children\": [{\"id\": \"abouttext\", \"type\": \"text\", \"text\": \"Mean (+/- SE) profile over visits by treatment, e.g. change from baseline in a lab or efficacy parameter. Summary statistics are computed by the step.\", \"visible\": \"\"}]}], \"syntaxversion\": \"1.3.0\", \"values\": {\"inputtable1\": {\"library\": \"\", \"table\": \"\"}, \"visVar\": [], \"valVar\": [], \"trtVar\": [], \"stat\": null, \"yLabel\": \"Mean change from baseline\", \"title\": \"\"}}",
  "flowMetadata": "{\"inputPorts\": [{\"name\": \"inputtable1\", \"displayName\": \"inputtable1\", \"minEntries\": 1, \"maxEntries\": 1, \"defaultBindingType\": \"table\"}], \"outputPorts\": []}"
}