{
  "type": "code",
  "name": "Clinical Swimmer Plot",
  "displayName": "Clinical Swimmer Plot",
  "description": "Swimmer plot of treatment duration per subject, with response duration overlay and arrows for ongoing treatment.",
  "templates": {
    "SAS": "/* Clinical Swimmer Plot */\nproc sort data=&inputtable1 out=work._sw; by &durVar_1_name; run;\ndata work._sw; set work._sw;\n  _start=0;\n  %if %length(&ongVar_1_name) %then %do; if upcase(&ongVar_1_name)='Y' then _ong=&durVar_1_name+0.4; %end;\nrun;\nods graphics on / width=9in height=%sysevalf(1.5+0.22*&sysnobs)in;\ntitle \"&title\";\nproc sgplot data=work._sw nocycleattrs;\n  highlow y=&idVar_1_name low=_start high=&durVar_1_name / type=bar group=&grpVar_1_name barwidth=0.6 name='bar';\n  %if %length(&rsVar_1_name) and %length(&reVar_1_name) %then %do;\n  highlow y=&idVar_1_name low=&rsVar_1_name high=&reVar_1_name / lineattrs=(color=black thickness=2) legendlabel='Response duration' name='rsp';\n  %end;\n  %if %length(&ongVar_1_name) %then %do;\n  scatter y=&idVar_1_name x=_ong / markerattrs=(symbol=trianglerightfilled color=black) legendlabel='Ongoing' name='ong';\n  %end;\n  yaxis discreteorder=data display=(nolabel) valueattrs=(size=7);\n  xaxis label=\"&xLabel\" min=0;\n  keylegend / title='';\nrun;\ntitle;\n"
  },
  "prompts": {},
  "ui": "{\"showPageContentOnly\": true, \"pages\": [{\"id\": \"page1\", \"type\": \"page\", \"label\": \"Options\", \"children\": [{\"id\": \"inputtable1\", \"type\": \"inputtable\", \"label\": \"Input table\", \"required\": true, \"placeholder\": \"\", \"visible\": \"\"}, {\"id\": \"idVar\", \"type\": \"columnselector\", \"label\": \"Subject ID\", \"include\": null, \"order\": false, \"columntype\": \"a\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"durVar\", \"type\": \"columnselector\", \"label\": \"Treatment duration\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"grpVar\", \"type\": \"columnselector\", \"label\": \"Colour by (e.g. BOR)\", \"include\": null, \"order\": false, \"columntype\": \"a\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"rsVar\", \"type\": \"columnselector\", \"label\": \"Response start\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 0, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"reVar\", \"type\": \"columnselector\", \"label\": \"Response end\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 0, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"ongVar\", \"type\": \"columnselector\", \"label\": \"Ongoing flag (Y/N)\", \"include\": null, \"order\": false, \"columntype\": \"a\", \"max\": 1, \"min\": 0, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"xLabel\", \"type\": \"textfield\", \"label\": \"X-axis label\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}, {\"id\": \"title\", \"type\": \"textfield\", \"label\": \"Graph title\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}]}, {\"id\": \"about\", \"type\": \"page\", \"label\": \"About\", \"children\": [{\"id\": \"abouttext\", \"type\": \"text\", \"text\": \"Swimmer plot of treatment duration per subject, with response duration overlay and arrows for ongoing treatment.\", \"visible\": \"\"}]}], \"syntaxversion\": \"1.3.0\", \"values\": {\"inputtable1\": {\"library\": \"\", \"table\": \"\"}, \"idVar\": [], \"durVar\": [], \"grpVar\": [], \"rsVar\": [], \"reVar\": [], \"ongVar\": [], \"xLabel\": \"Months since start of treatment\", \"title\": \"\"}}",
  "flowMetadata": "{\"inputPorts\": [{\"name\": \"inputtable1\", \"displayName\": \"inputtable1\", \"minEntries\": 1, \"maxEntries\": 1, \"defaultBindingType\": \"table\"}], \"outputPorts\": []}"
}