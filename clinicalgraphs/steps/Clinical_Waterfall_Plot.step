{
  "type": "code",
  "name": "Clinical Waterfall Plot",
  "displayName": "Clinical Waterfall Plot",
  "description": "Waterfall plot of best percent change from baseline in tumour size per subject, coloured by best overall response, with RECIST reference lines at +20% and -30%.",
  "templates": {
    "SAS": "/* Clinical Waterfall Plot */\nproc sort data=&inputtable1 out=work._wf; by descending &pchgVar_1_name; run;\ndata work._wf; set work._wf; _bar=_n_; run;\nods graphics on / width=9in height=5in;\ntitle \"&title\";\nproc sgplot data=work._wf;\n  vbarparm category=_bar response=&pchgVar_1_name / group=&grpVar_1_name groupdisplay=cluster datalabelfitpolicy=none;\n  refline &upper &lower / axis=y lineattrs=(pattern=dash);\n  xaxis display=(noticks novalues) label=\"Subjects\";\n  yaxis label=\"Best change from baseline (%)\" values=(-100 to 100 by 20);\n  keylegend / title=\"Best response\";\nrun;\ntitle;\n"
  },
  "prompts": {},
  "ui": "{\"showPageContentOnly\": true, \"pages\": [{\"id\": \"page1\", \"type\": \"page\", \"label\": \"Options\", \"children\": [{\"id\": \"inputtable1\", \"type\": \"inputtable\", \"label\": \"Input table\", \"required\": true, \"placeholder\": \"\", \"visible\": \"\"}, {\"id\": \"pchgVar\", \"type\": \"columnselector\", \"label\": \"Best % change variable\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"grpVar\", \"type\": \"columnselector\", \"label\": \"Colour by (e.g. BOR)\", \"include\": null, \"order\": false, \"columntype\": \"a\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"upper\", \"type\": \"textfield\", \"label\": \"Upper reference line (PD)\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}, {\"id\": \"lower\", \"type\": \"textfield\", \"label\": \"Lower reference line (PR)\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}, {\"id\": \"title\", \"type\": \"textfield\", \"label\": \"Graph title\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}]}, {\"id\": \"about\", \"type\": \"page\", \"label\": \"About\", \"children\": [{\"id\": \"abouttext\", \"type\": \"text\", \"text\": \"Waterfall plot of best percent change from baseline in tumour size per subject, coloured by best overall response, with RECIST reference lines at +20% and -30%.\", \"visible\": \"\"}]}], \"syntaxversion\": \"1.3.0\", \"values\": {\"inputtable1\": {\"library\": \"\", \"table\": \"\"}, \"pchgVar\": [], \"grpVar\": [], \"upper\": \"20\", \"lower\": \"-30\", \"title\": \"\"}}",
  "flowMetadata": "{\"inputPorts\": [{\"name\": \"inputtable1\", \"displayName\": \"inputtable1\", \"minEntries\": 1, \"maxEntries\": 1, \"defaultBindingType\": \"table\"}], \"outputPorts\": []}"
