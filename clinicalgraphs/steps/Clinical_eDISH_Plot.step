{
  "type": "code",
  "name": "Clinical eDISH Plot",
  "displayName": "Clinical eDISH Plot",
  "description": "eDISH plot (Hy's Law screening): peak ALT/ULN vs peak total bilirubin/ULN on log scales, with reference lines at 3xULN ALT and 2xULN bilirubin defining the four quadrants.",
  "templates": {
    "SAS": "/* Clinical eDISH Plot */\nods graphics on / width=7in height=7in;\ntitle \"&title\";\nproc sgplot data=&inputtable1;\n  scatter x=&altVar_1_name y=&biliVar_1_name / group=&trtVar_1_name markerattrs=(symbol=circlefilled) transparency=0.3;\n  refline 3 / axis=x lineattrs=(pattern=dash) label='3xULN';\n  refline 2 / axis=y lineattrs=(pattern=dash) label='2xULN';\n  inset \"Potential Hy's Law\" / position=topright;\n  inset \"Temple's Corollary\" / position=bottomright;\n  inset \"Hyperbilirubinemia\" / position=topleft;\n  xaxis type=log logbase=10 min=0.1 label='Peak ALT (/ULN)';\n  yaxis type=log logbase=10 min=0.1 label='Peak total bilirubin (/ULN)';\n  keylegend / title='';\nrun;\ntitle;\n"
  },
  "prompts": {},
  "ui": "{\"showPageContentOnly\": true, \"pages\": [{\"id\": \"page1\", \"type\": \"page\", \"label\": \"Options\", \"children\": [{\"id\": \"inputtable1\", \"type\": \"inputtable\", \"label\": \"Input table\", \"required\": true, \"placeholder\": \"\", \"visible\": \"\"}, {\"id\": \"altVar\", \"type\": \"columnselector\", \"label\": \"Peak ALT/ULN\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"biliVar\", \"type\": \"columnselector\", \"label\": \"Peak bilirubin/ULN\", \"include\": null, \"order\": false, \"columntype\": \"n\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"trtVar\", \"type\": \"columnselector\", \"label\": \"Treatment variable\", \"include\": null, \"order\": false, \"columntype\": \"a\", \"max\": 1, \"min\": 1, \"visible\": \"\", \"table\": \"inputtable1\"}, {\"id\": \"title\", \"type\": \"textfield\", \"label\": \"Graph title\", \"placeholder\": \"\", \"required\": false, \"visible\": \"\"}]}, {\"id\": \"about\", \"type\": \"page\", \"label\": \"About\", \"children\": [{\"id\": \"abouttext\", \"type\": \"text\", \"text\": \"eDISH plot (Hy's Law screening): peak ALT/ULN vs peak total bilirubin/ULN on log scales, with reference lines at 3xULN ALT and 2xULN bilirubin defining the four quadrants.\", \"visible\": \"\"}]}], \"syntaxversion\": \"1.3.0\", \"values\": {\"inputtable1\": {\"library\": \"\", \"table\": \"\"}, \"altVar\": [], \"biliVar\": [], \"trtVar\": [], \"title\": \"\"}}",
  "flowMetadata": "{\"inputPorts\": [{\"name\": \"inputtable1\", \"displayName\": \"inputtable1\", \"minEntries\": 1, \"maxEntries\": 1, \"defaultBindingType\": \"table\"}], \"outputPorts\": []}"
}