t\t\t\t\t\"label\": \"Bottom Left\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"bottomright\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Bottom Right\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"left\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Left\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"right\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Right\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"top\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Top\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"topleft\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Top Left\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"topright\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Top Right\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"orientation\",\n\t\t\t\t\t\t\t\"type\": \"radiogroup\",\n\t\t\t\t\t\t\t\"label\": \"Legend orientation:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"automatic\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Automatic\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"horizontal\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Horizontal\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"vertical\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Vertical\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"showinset\",\n\t\t\t\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\t\t\t\"label\": \"Show response-category legend inset (CR/PR/SD/PD/NE)\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"yaxisSection\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Y Axis Values\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"yaxismin\",\n\t\t\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t\t\t\t\"label\": \"Minimum:\",\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"min\": -100,\n\t\t\t\t\t\t\t\"max\": 100,\n\t\t\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"yaxismax\",\n\t\t\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t\t\t\t\"label\": \"Maximum:\",\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"min\": -100,\n\t\t\t\t\t\t\t\"max\": 100,\n\t\t\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"yaxisincrement\",\n\t\t\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t\t\t\t\"label\": \"Increment:\",\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\t\t\"max\": 100,\n\t\t\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"about\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"aboutText\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"The **Clinical Waterfall Graph** custom step creates a waterfall chart showing change in tumor size (or any change-from-baseline measure) by subject, colored by treatment/response group. It is a SAS Studio Custom Step conversion of the classic \\\"Change in Tumor Size Graph\\\" Custom Task (Custom Task Tuesday, June 2019), which was itself based on Sanjay Matange's Graphically Speaking post on clinical graphs.\\n\\nUSER INTERFACE\\n\\n- Input table: the analysis data set (one row per subject).\\n- Subject ID variable: character ID plotted along the X axis.\\n- Change variable: numeric change-from-baseline value plotted as the bar response.\\n- Group variable (optional): character variable used to color/group the bars (e.g. best response).\\n- Data label variable (optional): character variable used as the bar data label.\\n- Title 1 / Title 2: graph titles.\\n- Color theme, Legend location/position/orientation: standard SAS Studio graph styling options.\\n- Show response-category legend inset: toggles the CR/PR/SD/PD/NE inset box from the original blog post.\\n- Y axis minimum/maximum/increment: controls the YAXIS VALUES= range.\\n\\nConverted from Custom Task XML (Velocity) to a Custom Step (JSON UI + SAS macro language).\\nVersion 1.0.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"title1\": {\n\t\t\t\"value\": \"Change in Tumor Size\"\n\t\t},\n\t\t\"title2\": {\n\t\t\t\"value\": \"ITT Population\"\n\t\t},\n\t\t\"theme\": {\n\t\t\t\"value\": \"inspire\"\n\t\t},\n\t\t\"legendloc\": {\n\t\t\t\"value\": \"inside\"\n\t\t},\n\t\t\"legendpos\": {\n\t\t\t\"value\": \"topright\"\n\t\t},\n\t\t\"orientation\": {\n\t\t\t\"value\": \"automatic\"\n\t\t},\n\t\t\"showinset\": {\n\t\t\t\"value\": true\n\t\t},\n\t\t\"yaxismin\": {\n\t\t\t\"value\": -100\n\t\t},\n\t\t\"yaxismax\": {\n\t\t\t\"value\": 60\n\t\t},\n\t\t\"yaxisincrement\": {\n\t\t\t\"value\": 20\n\t\t}\n\t}\n}","localUi":"{\"pages\":[{\"children\":[{\"id\":\"inputtable1\",\"label\":\"Input table\",\"placeholder\":\"\",\"required\":true,\"type\":\"inputtable\"},{\"children\":[{\"columntype\":\"c\",\"id\":\"cidvar\",\"label\":\"Subject/case ID variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"n\",\"id\":\"changevar\",\"label\":\"Change-from-baseline variable:\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"c\",\"id\":\"groupvar\",\"label\":\"Group variable (color, optional):\",\"max\":1,\"min\":0,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"c\",\"id\":\"labelvar\",\"label\":\"Data label variable (optional):\",\"max\":1,\"min\":0,\"order\":false,\"table\":\"inputtable1\",\"type\":\"columnselector\",\"visible\":\"\"}],\"id\":\"rolesSection\",\"label\":\"Roles\",\"open\":true,\"type\":\"section\"}],\"id\":\"dataPage\",\"label\":\"Data\",\"type\":\"page\"},{\"children\":[{\"children\":[{\"id\":\"title1\",\"label\":\"Title 1:\",\"placeholder\":\"Enter a title\",\"required\":true,\"type\":\"textfield\",\"visible\":\"\"},{\"id\":\"title2\",\"label\":\"Title 2:\",\"placeholder\":\"Enter a second title\",\"required\":false,\"type\":\"textfield\",\"visible\":\"\"}],\"id\":\"titleSection\",\"label\":\"Title\",\"open\":true,\"type\":\"section\"},{\"children\":[{\"id\":\"theme\",\"items\":[{\"label\":\"SAS Inspire\",\"value\":\"inspire\"},{\"label\":\"SAS Illuminate\",\"value\":\"illuminate\"},{\"label\":\"Grayscale\",\"value\":\"grayscale\"},{\"label\":\"Pastel\",\"value\":\"pastel\"},{\"label\":\"Bright\",\"value\":\"bright\"},{\"label\":\"Dark\",\"value\":\"dark\"},{\"label\":\"Default (no colors specified)\",\"value\":\"default\"}],\"label\":\"Color theme:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\"}],\"id\":\"colorSection\",\"label\":\"Colors\",\"open\":true,\"type\":\"section\"},{\"children\":[{\"id\":\"legendloc\",\"items\":[{\"label\":\"Inside\",\"value\":\"inside\"},{\"label\":\"Outside\",\"value\":\"outside\"}],\"label\":\"Legend location:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\"},{\"id\":\"legendpos\",\"items\":[{\"label\":\"Bottom\",\"value\":\"bottom\"},{\"label\":\"Bottom Left\",\"value\":\"bottomleft\"},{\"label\":\"Bottom Right\",\"value\":\"bottomright\"},{\"label\":\"Left\",\"value\":\"left\"},{\"label\":\"Right\",\"value\":\"right\"},{\"label\":\"Top\",\"value\":\"top\"},{\"label\":\"Top Left\",\"value\":\"topleft\"},{\"label\":\"Top Right\",\"value\":\"topright\"}],\"label\":\"Legend position:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\"},{\"id\":\"orientation\",\"items\":[{\"label\":\"Automatic\",\"value\":\"automatic\"},{\"label\":\"Horizontal\",\"value\":\"horizontal\"},{\"label\":\"Vertical\",\"value\":\"vertical\"}],\"label\":\"Legend orientation:\",\"type\":\"radiogroup\",\"visible\":\"\"},{\"id\":\"showinset\",\"label\":\"Show response-category legend inset (CR/PR/SD/PD/NE)\",\"type\":\"checkbox\",\"visible\":\"\"}],\"id\":\"legendSection\",\"label\":\"Legend\",\"open\":true,\"type\":\"section\"},{\"children\":[{\"id\":\"yaxismin\",\"integer\":true,\"label\":\"Minimum:\",\"max\":100,\"min\":-100,\"placeholder\":\"\",\"required\":true,\"type\":\"numberfield\",\"visible\":\"\"},{\"id\":\"yaxismax\",\"integer\":true,\"label\":\"Maximum:\",\"max\":100,\"min\":-100,\"placeholder\":\"\",\"required\":true,\"type\":\"numberfield\",\"visible\":\"\"},{\"id\":\"yaxisincrement\",\"integer\":true,\"label\":\"Increment:\",\"max\":100,\"min\":1,\"placeholder\":\"\",\"required\":true,\"type\":\"numberfield\",\"visible\":\"\"}],\"id\":\"yaxisSection\",\"label\":\"Y Axis Values\",\"open\":true,\"type\":\"section\"}],\"id\":\"appearancePage\",\"label\":\"Appearance\",\"type\":\"page\"},{\"children\":[{\"id\":\"aboutText\",\"text\":\"The **Clinical Waterfall Graph** custom step creates a waterfall chart showing change in tumor size (or any change-from-baseline measure) by subject, colored by treatment/response group. It is a SAS Studio Custom Step conversion of the classic \\\"Change in Tumor Size Graph\\\" Custom Task (Custom Task Tuesday, June 2019), which was itself based on Sanjay Matange's Graphically Speaking post on clinical graphs.\\n\\nUSER INTERFACE\\n\\n- Input table: the analysis data set (one row per subject).\\n- Subject ID variable: character ID plotted along the X axis.\\n- Change variable: numeric change-from-baseline value plotted as the bar response.\\n- Group variable (optional): character variable used to color/group the bars (e.g. best response).\\n- Data label variable (optional): character variable used as the bar data label.\\n- Title 1 / Title 2: graph titles.\\n- Color theme, Legend location/position/orientation: standard SAS Studio graph styling options.\\n- Show response-category legend inset: toggles the CR/PR/SD/PD/NE inset box from the original blog post.\\n- Y axis minimum/maximum/increment: controls the YAXIS VALUES= range.\\n\\nConverted from Custom Task XML (Velocity) to a Custom Step (JSON UI + SAS macro language).\\nVersion 1.0.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"about\",\"label\":\"About\",\"type\":\"page\"}],\"showPageContentOnly\":true,\"syntaxversion\":\"1.3.0\",\"values\":{\"legendloc\":{\"value\":\"inside\"},\"legendpos\":{\"value\":\"topright\"},\"orientation\":{\"value\":\"automatic\"},\"showinset\":{\"value\":true},\"theme\":{\"value\":\"inspire\"},\"title1\":{\"value\":\"Change in Tumor Size\"},\"title2\":{\"value\":\"ITT Population\"},\"yaxisincrement\":{\"value\":20},\"yaxismax\":{\"value\":60},\"yaxismin\":{\"value\":-100}}}","templates":{"SAS":"/*============================================================================*\n * Custom Step:   Clinical Waterfall Graph                                    *\n * Converted from the SAS Studio Custom Task \"Change in Tumor Size Graph\"     *\n * (Velocity XML .ctm) shown in Custom Task Tuesday, June 2019.               *\n *                                                                            *\n * Velocity construct              ->  SAS macro construct                   *\n * -------------------------------------------------------------------------- *\n * $variable                       ->  &variable                             *\n * #if / #end                      ->  %if %then %do; / %end;                *\n * #foreach($item in $ROLE)$item#end (single-select role) -> &role directly  *\n *============================================================================*/\n\n%macro _clin_waterfall(\n        data=,          /* resolved two-level input table, e.g. &inputtable1 */\n        cidvar=,        /* character subject/case ID variable                */\n        changevar=,     /* numeric change-from-baseline variable             */\n        groupvar=,      /* character grouping (color) variable - optional    */\n        labelvar=,      /* character data label variable - optional         */\n        title1=,\n        title2=,\n        theme=,         /* inspire illuminate grayscale pastel bright dark default */\n        legendloc=,     /* inside / outside */\n        legendpos=,     /* bottom bottomleft bottomright left right top topleft topright */\n        orientation=,   /* automatic / horizontal / vertical */\n        showinset=,     /* Y/N - show the RECIST response-category inset   */\n        ymin=,\n        ymax=,\n        yinc=\n        );\n\n    %local fillcolors;\n\n    /* ---- color theme, same palettes as the original custom task ---- */\n    %if %upcase(&theme)=INSPIRE %then\n        %let fillcolors=cx21b9b7 cx4141e0 cx7db71a cx8e2f8a cxd38506 cx0abf85 cx2f90ec;\n    %else %if %upcase(&theme)=ILLUMINATE %then\n        %let fillcolors=cx00929f cxf08000 cx90b328 cx3d5aae cxffca39 cxa6427c cx9c2910 cx736519;\n    %else %if %upcase(&theme)=GRAYSCALE %then\n        %let fillcolors=cx585858 cxa2a2a2 cx1e1e1e cx707070 cxbbbbbb cx3b3b3b cxd0d0d0;\n    %else %if %upcase(&theme)=PASTEL %then\n        %let fillcolors=cxb3e2cd cxfdcdac cxcbd5e8 cxf4cae4 cxe6f5c9 cxfff2ae cxf1e2cc cxcccccc;\n    %else %if %upcase(&theme)=BRIGHT %then\n        %let fillcolors=cx3190D0 cxFF991A cx3EBB3B cxF23E39 cxAF7ED9 cxA77063 cxFF8EDD cxD6D91A;\n    %else %if %upcase(&theme)=DARK %then\n        %let fillcolors=cx1b9e77 cxd95f02 cx7570b3 cxe7298a cx66a61e cxe6ab02 cxa6761d cx666666;\n\n    title \"&title1\";\n    %if %length(&title2) %then %do;\n        title2 \"&title2\";\n    %end;\n\n    proc sgplot data=&data nowall noborder;\n        %if %upcase(&theme) ne DEFAULT %then %do;\n            styleattrs datacolors=(&fillcolors) datacontrastcolors=(black);\n        %end;\n\n        vbar &cidvar /\n            response=&changevar\n            %if %length(&groupvar) %then %do; group=&groupvar %end;\n            categoryorder=respdesc\n            %if %length(&labelvar) %then %do; datalabel=&labelvar %end;\n            datalabelattrs=(size=5 weight=bold)\n            groupdisplay=cluster clusterwidth=1;\n\n        refline 20 -30 / lineattrs=(pattern=shortdash);\n        xaxis display=none;\n        yaxis values=(&ymin to &ymax by &yinc);\n\n        %if %upcase(&showinset)=Y %then %do;\n            inset (\"C=\"=\"CR\" \"R=\"=\"PR\" \"S=\"=\"SD\" \"P=\"=\"PD\" \"N=\"=\"NE\") / title='BCR'\n                position=bottomleft border textattrs=(size=6 weight=bold);\n        %end;\n\n        keylegend / title='' location=&legendloc position=&legendpos border\n            %if %upcase(&orientation)=HORIZONTAL %then %do; down=1 %end;\n            %if %upcase(&orientation)=VERTICAL %then %do; across=1 %end;\n            ;\n    run;\n\n    title;\n%mend _clin_waterfall;\n\n%_clin_waterfall(\n    data=&inputtable1,\n    cidvar=&cidvar,\n    changevar=&changevar,\n    groupvar=&groupvar,\n    labelvar=&labelvar,\n    title1=&title1,\n    title2=&title2,\n    theme=&theme,\n    legendloc=&legendloc,\n    legendpos=&legendpos,\n    orientation=&orientation,\n    showinset=&showinset,\n    ymin=&yaxismin,\n    ymax=&yaxismax,\n    yinc=&yaxisincrement\n    );\n"}}
